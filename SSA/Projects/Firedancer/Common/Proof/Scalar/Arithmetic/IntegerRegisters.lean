import SSA.Projects.Firedancer.Common.Proof.Scalar.Arithmetic.SignedRadix

/-! Integer registers for `%107` through `%446`. The entry consists of the
24 radix-2^21 digits: the highest contains the remaining 29 input bits.
The link to LLVM registers is proved separately; these definitions carry no
execution or overflow assumption. -/

namespace Firedancer.Common.ScalarArithmetic.IntegerRegisters

abbrev Digits := Fin 24 → Int

def Bounded (d : Digits) : Prop :=
  ∀ i, 0 ≤ d i ∧ d i < 2 ^ (if i = 23 then 29 else 21)


