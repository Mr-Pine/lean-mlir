module

public import SSA.Projects.RIR.Syntax.Elab

/-! # `mlir_def`: register types through the type trie -/

namespace LeanMLIR.RIR.Tests.Syntax

@[expose] public section

/-! A multi-block function with mixed types: its trie agrees with `Γ` at every value. -/

mlir_def branchy := {
  ^bb0(%arg0: i32, %arg1: i64, %arg2: !llvm.ptr):
    %0 = "llvm.mlir.constant"() <{value = 0 : i32}> : () -> i32
    %1 = "llvm.icmp"(%arg0, %0) <{predicate = 0 : i64}> : (i32, i32) -> i1
    "llvm.cond_br"(%1, %arg1)[^bb1, ^bb2] <{operandSegmentSizes = array<i32: 1, 0, 1>}> : (i1, i64) -> ()
  ^bb1:
    %2 = "llvm.load"(%arg2) <{alignment = 8 : i64, ordering = 0 : i64}> : (!llvm.ptr) -> vector<4xi32>
    %3 = "llvm.mlir.constant"() <{value = 1 : i64}> : () -> i64
    %4 = "llvm.add"(%arg1, %3) : (i64, i64) -> i64
    "llvm.br"(%4)[^bb2] : (i64) -> ()
  ^bb2(%5: i64):
    %6 = "llvm.trunc"(%5) : (i64) -> i16
    %7 = "llvm.zext"(%6) : (i16) -> i64
    "llvm.return"(%7) : (i64) -> ()
}

example : ∀ k : Fin branchy.Γ.n, branchy.tree.get k = branchy.Γ.ty k := by decide
example : branchy.Γ.vals = [.bv 32, .bv 1, .vec 4 32, .bv 64, .bv 64, .bv 64, .bv 16, .bv 64] :=
  rfl

