def avx2BasePoint (k : Fin 64) : Extended F :=
  scale (avx2BaseScale k) (serialBasePoint k)

theorem serialBaseCache_correct (k : Fin 64) :
    serialBaseCache k = serialCache d (serialBasePoint k) := by
  fin_cases k <;> decide +kernel

theorem avx2BaseCache_correct (k : Fin 64) :
    avx2BaseCache k = avx2Cache (avx2BasePoint k) := by
  fin_cases k <;> decide +kernel

theorem avx2BaseScale_ne_zero (k : Fin 64) : avx2BaseScale k ≠ 0 := by
  fin_cases k <;> decide +kernel

/-- All static table entries are related, with exact source-byte certificates. -/
theorem baseTable_related (k : Fin 64) :
    Related (serialBasePoint k) (avx2BasePoint k) :=
  ⟨avx2BaseScale k, avx2BaseScale_ne_zero k, rfl⟩

theorem baseCache_related (k : Fin 64) :
    CachedRelated (serialBaseCache k) (avx2BaseCache k) := by
  rw [serialBaseCache_correct, avx2BaseCache_correct]
  exact cached_related d d_spec (by decide) (baseTable_related k)

theorem serialBasePoint_zero : serialBasePoint 0 = fromFD basePoint := by
  decide +kernel

def serialBaseAdvance (k : Fin 63) : Extended F :=
  serialAdd d (serialDouble (serialBasePoint 0)) (serialBasePoint k.castSucc)

theorem serialBaseAdvance_certificate (k : Fin 63) :
    (serialBaseAdvance k).Z ≠ 0 ∧
    serialBasePoint k.succ =
      scale ((serialBaseAdvance k).Z)⁻¹ (serialBaseAdvance k) := by
  fin_cases k <;> decide +kernel

theorem serialBaseAdvance_related (k : Fin 63) :
    Related (serialBaseAdvance k) (serialBasePoint k.succ) :=
  ⟨_, inv_ne_zero (serialBaseAdvance_certificate k).1,
    (serialBaseAdvance_certificate k).2⟩

def baseGroup : Edwards.Point curve := basePoint.toAffine wellFormed_basePoint

theorem serialBasePoint_represents (k : Fin 64) :
    Represents (serialBasePoint k) ((2*k.val+1) • baseGroup) := by
  induction k using Fin.induction with
  | zero =>
    rw [serialBasePoint_zero]
    refine ⟨wellFormed_basePoint, ?_⟩
    simp [baseGroup]
  | succ k ih =>
    have hbase : Represents (serialBasePoint 0) baseGroup := by
      rw [serialBasePoint_zero]
      exact ⟨wellFormed_basePoint, rfl⟩
    have hstep := represents_serialAdd (represents_serialDouble hbase) ih
    have he : baseGroup + baseGroup + (2*k.val+1) • baseGroup =
        (2*(k.val+1)+1) • baseGroup := by
      rw [← two_nsmul, ← add_nsmul]
      congr 1
      omega
    exact represents_related (he ▸ hstep) (serialBaseAdvance_related k)

theorem avx2BasePoint_represents (k : Fin 64) :
    Represents (avx2BasePoint k) ((2*k.val+1) • baseGroup) :=
  represents_related (serialBasePoint_represents k) (baseTable_related k)

/-- Actual width-5 constructor plus certified static width-8 table. -/
def serialDoubleBaseTable (A : Extended F) : Fin 8 ⊕ Fin 64 → Extended F
  | .inl k => serialWidth5 d A k
  | .inr k => serialBasePoint k

def avx2DoubleBaseTable (A : Extended F) : Fin 8 ⊕ Fin 64 → Extended F
  | .inl k => avx2Width5 A k
  | .inr k => avx2BasePoint k

/-- No table-correctness hypothesis remains in this algebraic endpoint. -/
theorem doubleBaseTable_related {A A' : Extended F} (hA : Related A A')
    (k : Fin 8 ⊕ Fin 64) :
    Related (serialDoubleBaseTable A k) (avx2DoubleBaseTable A' k) := by
  cases k with
  | inl k => exact width5_related d d_spec (by decide) hA k
  | inr k => exact baseTable_related k

theorem doubleBase_schedule_related {A A' P P' : Extended F}
    (hA : Related A A') (hP : Related P P')
    (ops : List (Operation (Fin 8 ⊕ Fin 64))) :
    Related (ops.foldl (serialStep d (serialDoubleBaseTable A)) P)
      (ops.foldl (avx2Step (avx2DoubleBaseTable A')) P') :=
  schedule_related d d_spec (by decide) _ _ (doubleBaseTable_related hA) ops hP

theorem doubleBase_schedule_compress_eq {Bytes : Type*} (encode : F × F → Bytes)
    {A A' P P' : Extended F} (hA : Related A A') (hP : Related P P')
    (ops : List (Operation (Fin 8 ⊕ Fin 64))) :
    compressWith encode (ops.foldl (avx2Step (avx2DoubleBaseTable A')) P') =
      compressWith encode (projectiveAsExtended
        (ops.foldl (serialStep d (serialDoubleBaseTable A)) P)) :=
  schedule_compress_eq encode d d_spec (by decide) _ _
    (doubleBaseTable_related hA) ops hP

end Agave.Ed25519.Tables
