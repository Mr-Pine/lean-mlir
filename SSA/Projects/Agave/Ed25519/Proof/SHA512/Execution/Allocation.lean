/-! The entry block's exact constant/allocation prefix. Its body is taken
from the imported finalizer, including every one of the 70 stack slots. -/
namespace Agave.Ed25519.Verifier.Execution.SHA512Finalization

open LeanMLIR.RIR

/-- The slot address at its position in the emitted allocation sequence. -/
def slot (s : GlobalState) (i : Nat) : Pointer :=
  (allocateSlots s (slotSizes.take i)).allocaPtr

