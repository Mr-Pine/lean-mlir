set_option maxRecDepth 20000
set_option maxHeartbeats 1600000

private theorem modifyGet_apply (f : GlobalState → α × GlobalState) (s : GlobalState) :
    (modifyGet f : EffectM α) s = .value (f s) := rfl

/-- Execution of the actual imported instruction prefix, without a memory
safety assumption: RIR stack allocation itself is total. -/
theorem allocation_prefix (E : Env program.Γ) (s : GlobalState) :
    (List.foldlM Instr.run E (program.bb0.body.take 151) : EffectM (Env program.Γ)) s =
      .value (allocatedEnv E s, allocateSlots s slotSizes) := by
  simp [program.bb0, allocatedEnv, slot, allocateSlots, slotSizes,
    List.foldlM_cons, List.foldlM_nil, Instr.run, run_alloca,
    modifyGet_apply, Ty.wrap, EffectM.bind_eq, EffectM.pure_eq, mlir_effect, mlir_env]

end Agave.Ed25519.Verifier.Execution.SHA512Finalization
